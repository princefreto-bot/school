{
    "name": "dghubschool-classeur-backend",
    "version": "0.1.0",
    "description": "Backend TypeScript du Classeur Intelligent de Personnes (data.dghubschool.com)",
    "private": true,
    "main": "dist/server.js",
    "type": "commonjs",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc -p tsconfig.json && npm run build:frontend",
        "build:frontend": "cd ../classeur-frontend && npm install && npm run build",
        "start": "node dist/server.js",
        "test": "vitest run"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.108.2",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^4.22.2",
        "express-rate-limit": "^8.5.2",
        "jsonwebtoken": "^9.0.3",
        "multer": "^2.2.0",
        "node-cron": "^3.0.3",
        "papaparse": "^5.4.1",
        "pdf-parse": "^1.1.1",
        "tesseract.js": "^5.1.1",
        "xlsx": "^0.18.5"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/multer": "^1.4.12",
        "@types/node": "^20.14.0",
        "@types/node-cron": "^3.0.11",
        "@types/papaparse": "^5.3.14",
        "@types/pdf-parse": "^1.1.4",
        "tsx": "^4.19.0",
        "typescript": "^5.6.0",
        "vitest": "^2.1.0"
    }
}
