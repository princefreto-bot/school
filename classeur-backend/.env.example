PORT=4001
NODE_ENV=development

# Même projet Supabase que le backend principal DGhubschool.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Secret propre à ce service, distinct du JWT_SECRET de dghubschool.com.
CLASSEUR_JWT_SECRET=

# Doit être IDENTIQUE à CLASSEUR_INTERNAL_SECRET défini dans backend/.env du service principal.
CLASSEUR_INTERNAL_SECRET=

MAIN_BACKEND_URL=https://dghubschool.com
CLASSEUR_FRONTEND_URL=https://data.dghubschool.com
CLASSEUR_ALLOWED_ORIGINS=https://data.dghubschool.com
